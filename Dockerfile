# CryptoAI Pro V5.7.1 - Unicode Futures symbol training repair + transparent TP/SL paper monitoring.
# Existing V5.7 models and paper SQLite stay intact on the current 10GB Render disk; no real orders.
# True insufficient listing history (e.g. CTUSDT) stays pending, retried, never fabricated.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data AUTO_TRAIN=false COIN_AUTO_TRAIN=true COIN_RETRAIN_HOURS=6 COIN_RETRY_SECONDS=3600 ENABLE_REST_SCANNER=false MAX_WATCHED=700 KLINE_SOCKET_SIZE=72 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
WORKDIR /app
RUN python -c "import base64,io,tarfile; blob=base64.b64decode(''); tarfile.open(fileobj=io.BytesIO(blob),mode='r:xz').extractall('/app',filter='data')"
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /app/data
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
