# CryptoAI Pro V2 - single-file mobile deploy. Public market data only.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data AUTO_TRAIN=true
WORKDIR /app
RUN python -c "import base64,io,tarfile; data=base64.b64decode(''); tarfile.open(fileobj=io.BytesIO(data),mode='r:xz').extractall('/app',filter='data')"
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /app/data
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
