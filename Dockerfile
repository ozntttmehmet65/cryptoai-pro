# CryptoAI Pro V5.3 - grouped all-eligible market WS streams + paced history + precise signal timestamps.
# Read-only signals, no orders. Binance 418/429 cooldown respected; missing data never fabricated.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data AUTO_TRAIN=true ENABLE_REST_SCANNER=false MAX_WATCHED=700 KLINE_SOCKET_SIZE=72
WORKDIR /app
RUN python -c "import base64,io,tarfile; blob=base64.b64decode(''); tarfile.open(fileobj=io.BytesIO(blob),mode='r:xz').extractall('/app',filter='data')"
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /app/data
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
