# CryptoAI Pro V6.0 - training-only adaptive ATR TP/SL, 4500 real 15m candles, clear phone-first trade watchlist.
# V6 models under /app/data/coin_models_v60; older coin models and persistent paper SQLite untouched.
# Read-only Binance USD-M Futures. NO real orders. Existing Render Standard 1 CPU / 2GB / 10GB disk.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data AUTO_TRAIN=false COIN_AUTO_TRAIN=true COIN_RETRAIN_HOURS=6 COIN_RETRY_SECONDS=3600 TRAIN_CANDLES=4500 ENABLE_REST_SCANNER=false MAX_WATCHED=700 KLINE_SOCKET_SIZE=72 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
WORKDIR /app
RUN python -c "import base64,io,tarfile; blob=base64.b64decode('' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
    '' \
