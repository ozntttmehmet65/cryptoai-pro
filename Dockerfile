# CryptoAI Pro V5.9: 58 causal technical features, chart-candidate watchlist and separate AI TP/SL holdout.
# Unicode futures; 1h/4h completed bars only; no additional server costs or orders.
# New /app/data/coin_models_v59; old coin_models_v58/v57 and paper SQLite preserved on 10 GB disk.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data AUTO_TRAIN=false COIN_AUTO_TRAIN=true COIN_RETRAIN_HOURS=6 COIN_RETRY_SECONDS=3600 TRAIN_CANDLES=3000 ENABLE_REST_SCANNER=false MAX_WATCHED=700 KLINE_SOCKET_SIZE=72 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
WORKDIR /app
RUN python -c "import base64,io,tarfile; blob=base64.b64decode(''); tarfile.open(fileobj=io.BytesIO(blob),mode='r:xz').extractall('/app',filter='data')"
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /app/data
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
