# CryptoAI Pro V5.2 - real-time browser price WebSocket + 5s fallback.
# Live USD-M Futures quotes, signal inference ONLY on completed 15m candles.
# No order execution; no fabricated quotes; no Binance rate-limit bypass.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data AUTO_TRAIN=true ENABLE_REST_SCANNER=false
WORKDIR /app
RUN python -c "import base64,io,tarfile; blob=base64.b64decode(''); tarfile.open(fileobj=io.BytesIO(blob),mode='r:xz').extractall('/app',filter='data')"
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /app/data
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
